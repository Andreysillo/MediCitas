# Copiar a .env y cambiar las contraseñas:  cp .env.example .env
# .env no se versiona (está en .gitignore); este archivo sí, como plantilla.

POSTGRES_USER=medicitas
# Va dentro de una URL de conexión: evitar @ : / ? #
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_DB=medicitas

# "no" en producción: solo se aplica el esquema, sin datos de prueba.
CARGAR_SEMILLA=si

# "keycloak" (por defecto, RF17): valida el JWT contra las llaves públicas del realm.
# "desarrollo": confía en la cabecera X-Usuario-Id SIN validar (solo para desarrollar sin levantar Keycloak).
AUTH_MODO=keycloak

# Puerto del navegador: http://localhost:8080
PUERTO_WEB=8080

# Usuario y contraseña de la CONSOLA DE ADMINISTRACIÓN de Keycloak (no son credenciales de la aplicación:
# los usuarios de prueba de MediCitas y su contraseña están en keycloak/realm-export.json y en el README).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar-esto
# Consola de Keycloak: http://localhost:8080/auth/admin (realm "medicitas"). Este puerto es el acceso directo.
PUERTO_KEYCLOAK=8081

# Solo para `docker compose --profile herramientas up` (pgAdmin en http://localhost:5050)
PGADMIN_EMAIL=admin@medicitas.dev
PGADMIN_PASSWORD=cambiar-esto
